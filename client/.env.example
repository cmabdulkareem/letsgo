# ─── Let's Go Client — Environment Variables ────────────────────────────────
# Copy this file to .env.local for local dev (overrides vite proxy).
# On Vercel: set these under Project → Settings → Environment Variables.

# Full URL of your deployed backend (no trailing slash).
# Local dev: leave empty — Vite proxy forwards /api → localhost:5000
# Production: https://your-letsgo-api.up.railway.app
VITE_API_URL=

# Public key from `npx web-push generate-vapid-keys` (same value as server WEB_PUSH_PUBLIC_KEY)
VITE_VAPID_PUBLIC_KEY=

# Optional: Google Maps / Leaflet tile provider API key
VITE_MAPS_API_KEY=
