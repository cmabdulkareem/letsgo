# ---- Core ----
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/letsgo
CLIENT_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:5000
FRONTEND_PUBLIC_URL=http://localhost:5173

# ---- Auth tokens ----
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=30

# ---- Email ----
# "console" logs emails to the server console (dev default). "smtp" uses nodemailer.
EMAIL_PROVIDER=console
EMAIL_FROM="Let's Go <no-reply@letsgo.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Web push (optional; generate with: npx web-push generate-vapid-keys) ----
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@letsgo.local

# ---- Storage ----
# "local" stores uploads under server/uploads. An S3-compatible provider can be
# wired through src/services/storageService.js without changing controllers.
STORAGE_PROVIDER=local
UPLOAD_MAX_MB=5

# ---- Maps ----
# The client uses OpenStreetMap/Leaflet by default and needs no key.
# Provide a key only if you swap the tile provider.
MAPS_API_KEY=

# ---- CORS / cookies ----
# Comma-separated list of allowed browser origins.
ALLOWED_ORIGINS=http://localhost:5173
# Set to "none" if the API and client are served from the same origin (secure default).
# "lax" is the right choice for cross-origin localhost dev with cookie auth.
COOKIE_SAMESITE=lax
