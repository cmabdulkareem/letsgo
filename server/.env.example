# ─── Let's Go Server — Environment Variables ────────────────────────────────
# Copy this file to .env for local dev.
# On Railway: paste each variable into the "Variables" tab.

NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string (replace <user>, <pass>, <cluster>)
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/letsgo?retryWrites=true&w=majority

# Your Vercel frontend URL (no trailing slash)
CLIENT_ORIGIN=https://your-letsgo-app.vercel.app

# Comma-separated list of allowed CORS origins (add your custom domain too)
ALLOWED_ORIGINS=https://your-letsgo-app.vercel.app

# Public URL the server uses to generate email verification links etc.
FRONTEND_PUBLIC_URL=https://your-letsgo-app.vercel.app

# ─── JWT ───────────────────────────────────────────────────────────────────
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=CHANGE_ME_64_CHAR_HEX
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=30

# ─── Email ─────────────────────────────────────────────────────────────────
# Set to "smtp" to send real emails; "console" logs them (dev only)
EMAIL_PROVIDER=smtp
EMAIL_FROM=Let's Go <no-reply@yourdomain.com>
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.xxxx

# ─── Web Push (VAPID) ──────────────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@yourdomain.com

# ─── File storage ──────────────────────────────────────────────────────────
# "local" stores uploads on disk (not persistent on Railway — use "cloudinary")
STORAGE_PROVIDER=local
UPLOAD_MAX_MB=5

# If STORAGE_PROVIDER=cloudinary:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── Misc ──────────────────────────────────────────────────────────────────
MAPS_API_KEY=
MESSAGE_RETENTION_DAYS=90
COOKIE_SAMESITE=none
